# Runtime data may contain forum excerpts, post identifiers and local author keys.
# Keep it on the local machine and never publish it with the source code.
data/*
!data/README.md
!data/.gitkeep
data.js

# Python caches and test output
__pycache__/
*.py[cod]
.pytest_cache/
.coverage
htmlcov/

# Local environments and editor settings
.env
.env.*
!.env.example
.venv/
venv/
.vscode/
.idea/

# Databases, logs, temporary files and OS metadata
*.sqlite3
*.sqlite3-shm
*.sqlite3-wal
*.log
*.tmp
*.bak
Thumbs.db
.DS_Store
